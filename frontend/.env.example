# ─────────────────────────────────────────────
# Frontend environment variables
# Copy this file to .env and fill in real values.
#
# IMPORTANT: In Vite, only variables prefixed with VITE_
# are exposed to browser code. Never put secrets here.
# ─────────────────────────────────────────────

# The URL of the backend API server.
# - Locally: Vite's dev proxy rewrites /api → localhost:3001,
#   so this is NOT needed during local development (the proxy
#   in vite.config.js handles it automatically).
# - On Vercel: set this to your deployed backend URL, e.g.
#   https://teamflow-api.onrender.com
VITE_API_BASE_URL=http://localhost:3001
