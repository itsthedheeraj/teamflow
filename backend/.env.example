# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# Use a NON-SUPERUSER role here. Superuser connections bypass RLS.
# See SETUP.md and docs/rls-setup.md for provider-specific connection details.
# Aiven: use the PostgreSQL URI from the Aiven console and include `sslmode=require`.
# If you only have one Aiven connection string, reuse it for both variables.
DATABASE_URL=postgresql://<aiven-user>:<password>@<host>:<port>/<database>?sslmode=require

# Used by migration and seed scripts when you have a separate admin-capable URI.
# If Aiven only gives you one connection string, set this to the same value as DATABASE_URL.
DATABASE_SUPERUSER_URL=postgresql://<aiven-user>:<password>@<host>:<port>/<database>?sslmode=require

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=7d
JWT_INVITE_EXPIRES_IN=48h

# ─────────────────────────────────────────────
# Stripe (test mode — fill these in from your Stripe dashboard)
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Stripe Price ID — create in Stripe Dashboard > Products > Add product > Add price (recurring, monthly)
STRIPE_PRO_PRICE_ID=price_REPLACE_ME

# ─────────────────────────────────────────────
# Resend (email delivery for invite links)
# Get your API key from: https://resend.com/api-keys
# Free tier: 100 emails/day, no credit card required.
# If RESEND_API_KEY is missing or blank, invite emails are skipped
# gracefully — the invite is still created and the link is logged to console.
# ─────────────────────────────────────────────


# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
